# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=quantitymeasurementdb
MYSQL_USER=qm_user
MYSQL_PASSWORD=qm_password
MYSQL_PORT=3306

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JPA_DDL_AUTO=update

# JWT Configuration
APP_JWT_SECRET=your-secret-key-change-this-to-a-long-random-value-for-production-1234567890
APP_JWT_EXPIRATION_MS=3600000
APP_JWT_ISSUER=quantity-measurement-app

# Default User Configuration
APP_DEFAULT_USERNAME=admin
APP_DEFAULT_EMAIL=admin@quantitymeasurement.local
APP_DEFAULT_FULL_NAME=Default Admin
APP_DEFAULT_PASSWORD=Admin@12345
APP_DEFAULT_ROLES=USER
APP_DEFAULT_USER_ENABLED=true

# Google OAuth2 Configuration (optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_AUTHORIZED_REDIRECT_URI=

# Java Options
JAVA_OPTS=-Xmx512m -Xms256m

